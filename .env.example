# Secure Share System environment settings
# This version is pre-configured for your project sender/receiver emails.
# You only need to fill OTP_SECRET and SMTP_PASS.

HOST=127.0.0.1
PORT=3000

# Admin email OTP verification
OTP_DELIVERY_MODE=email
ADMIN_2FA_TTL_SECONDS=300
ADMIN_2FA_MAX_ATTEMPTS=5

# REQUIRED: generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=PASTE_GENERATED_64_CHARACTER_SECRET_HERE

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Gmail account
SMTP_USER=systemsecureshare@gmail.com

# REQUIRED: paste Gmail App Password here, not the normal Gmail password.
SMTP_PASS=PASTE_GMAIL_APP_PASSWORD_HERE

# Email sender display and receiver email
OTP_FROM="Secure Share <systemsecureshare@gmail.com>"
OTP_TO_EMAIL=hassanbadha33@gmail.com

# Optional: password-reset codes go here during local demo. Leave blank to use each user email.
PASSWORD_RESET_TO_EMAIL=hassanbadha33@gmail.com
